# Both Vite and FastAPI read the root .env. Never commit your real values.
# Clerk Dashboard > API keys. Publishable keys are safe for the browser.
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk Frontend API origin, e.g. https://your-app.clerk.accounts.dev
CHESSO_CLERK_ISSUER=
# Exact frontend origins allowed for CORS and the Clerk JWT azp claim.
CHESSO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Private researcher token. Generate one with: openssl rand -hex 32
CHESSO_ADMIN_TOKEN=
# Neon pooled PostgreSQL connection URL. Server only; never use a VITE_ prefix.
# Leave blank for local SQLite until the Neon project is ready.
DATABASE_URL=
# Optional overrides. CHESSO_DATABASE is only used when DATABASE_URL is blank.
# CHESSO_DATABASE=data/web/chesso.sqlite3
# VITE_API_URL=https://api.example.com
# CHESSO_CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
